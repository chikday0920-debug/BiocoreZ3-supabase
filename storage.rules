rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de escaneo (Fase 7). Cada usuario solo puede leer/escribir
    // dentro de su propia carpeta scans/{uid}/...
    match /scans/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de perfil. Lectura publica (se muestran en el user-chip y en
    // perfiles compartidos); solo el dueño puede escribir la suya.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Denegado por defecto para cualquier otra ruta.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
