# BioCoreZ3 — variables de entorno
#
# En producción, estas keys se configuran como secrets de Supabase, no como
# variables de entorno normales:
#   supabase secrets set PLANT_ID_API_KEY=tu_api_key
#   supabase secrets set INSECT_ID_API_KEY=tu_api_key
#
# Para desarrollo local con `supabase functions serve`, copia este archivo a
# supabase/functions/.env y completa los valores ahí (ese archivo está en
# .gitignore, nunca se sube al repo).

# API key de Plant.id (Kindwise) — https://www.kindwise.com/plant-id —
# usada por supabase/functions/_shared/plantid.ts para identificar plantas.
PLANT_ID_API_KEY=

# API key de Insect.id (Kindwise) — https://www.kindwise.com/insect-id —
# usada por supabase/functions/_shared/insectid.ts para identificar fauna.
# LIMITACIÓN CONOCIDA: solo cubre insectos y arañas, no aves/mamíferos/
# reptiles/anfibios (ver el comentario en insectid.ts).
INSECT_ID_API_KEY=
